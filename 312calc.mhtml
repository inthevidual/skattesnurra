    const elements =3D {
      year: document.getElementById('tt-year'),
      ownership: document.getElementById('tt-ownership'),
      salaries: document.getElementById('tt-salaries'),
      shareCost: document.getElementById('tt-share-cost'),
      otherOwnership: document.getElementById('tt-other-ownership'),
      salaryYear: document.getElementById('tt-salary-year'),
      resultTotal: document.getElementById('tt-result-total'),
      resultAfterTax: document.getElementById('tt-result-after-tax'),
      resultYear: document.getElementById('tt-result-year'),
      resultOwnership: document.getElementById('tt-result-ownership'),
      resultBase: document.getElementById('tt-result-base'),
      resultReduction: document.getElementById('tt-result-reduction'),
      resultSalaryBased: document.getElementById('tt-result-salary-based'),
      resultInterest: document.getElementById('tt-result-interest'),
      resultDividend: document.getElementById('tt-result-dividend'),
      resultSalaryRequirement: document.getElementById('tt-result-salary-re=
quirement'),
    };

    const currencyFmt =3D new Intl.NumberFormat('sv-SE', { maximumFractionD=
igits: 0 });

    function formatCurrency(value) {
      return currencyFmt.format(Math.round(value)) + ' kr';
    }

    function parseNumber(value) {
      if (!value) return 0;
      const num =3D parseFloat(String(value).replace(/\s/g, '').replace(','=
, '.'));
