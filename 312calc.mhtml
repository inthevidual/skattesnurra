      const ownershipPct =3D Math.min(100, Math.max(0, parseNumber(elements=
.ownership?.value)));
      const ownership =3D ownershipPct / 100;
      const totalSalaries =3D parseNumber(elements.salaries?.value);
      const shareCost =3D parseNumber(elements.shareCost?.value);
      const otherOwnership =3D parseNumber(elements.otherOwnership?.value) =
