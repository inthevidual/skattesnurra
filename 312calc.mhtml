      const dividendAfterTax =3D dividendScope * 0.8;
      const salaryRequirement =3D salaryBased / 50;

      setText(elements.resultYear, year);
      setText(elements.resultOwnership, ownershipPct + '%');
      setText(elements.resultBase, formatCurrency(baseAmount));
      setText(elements.resultReduction, formatCurrency(baseReduction));
      setText(elements.resultSalaryBased, formatCurrency(salaryBased));
      setText(elements.resultInterest, formatCurrency(interest));
      setText(elements.resultDividend, formatCurrency(dividendScope));
      setText(elements.resultTotal, formatCurrency(dividendScope));
      setText(elements.resultAfterTax, formatCurrency(dividendAfterTax));
      setText(elements.resultSalaryRequirement, formatCurrency(salaryRequir=
ement));
      setText(elements.salaryYear, year - 1);
    }

    let calcFrame =3D 0;
